DATABASE_URL="postgresql://admin:adminpassword@localhost:5432/readtherules"
JWT_SECRET="troque-isto"
ANTHROPIC_API_KEY="sua-chave-da-anthropic"
PORT=3000
# IA gratuita (recomendado): chave do Google AI Studio (https://aistudio.google.com/apikey).
# Com IA_API_KEY definida, usa ela em vez do Claude. IA_BASE_URL/IA_MODEL trocam o provedor (ex.: Groq).
IA_API_KEY=
# IA_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
# IA_MODEL=gemini-2.5-flash
# Modelo de embeddings da busca semântica (pgvector). Só funciona com IA_API_KEY.
# IA_EMBED_MODEL=gemini-embedding-001
# Esqueci minha senha: SMTP para enviar o link (ex.: smtp://usuario:senha-de-app@smtp.gmail.com:587).
# Sem SMTP_URL, o link aparece no console do backend (bom para testar).
SMTP_URL=
# SMTP_FROM="Read the Rules <seu-email@gmail.com>"
# Endereço do front-end, usado no link do email.
FRONT_URL=http://localhost:5173
